{
  "paths": {
    "/match_text": {
      "post": {
        "description": "Score a resume against a job description (text inputs).",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "resume_text": {"type": "string"},
                  "jd_text": {"type": "string"}
                },
                "required": ["resume_text", "jd_text"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Match result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "final_score": {"type": "number"},
                    "recommendation": {"type": "string"},
                    "matched_skills": {"type": "array", "items": {"type": "string"}},
                    "missing_skills": {"type": "array", "items": {"type": "string"}},
                    "semantic_score": {"type": "number"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/rank_job": {
      "post": {
        "description": "Rank all students for a job by job_id (data-backed).",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {"type": "object", "properties": {"job_id": {"type": "string"}}, "required": ["job_id"]}
            }
          }
        },
        "responses": {
          "200": {"description": "List of ranked candidates"}
        }
      }
    }
  }
}
